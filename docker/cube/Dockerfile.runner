FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    qemu-system-x86 qemu-utils curl ca-certificates openssh-client sshpass \
    python3 procps virtiofsd && rm -rf /var/lib/apt/lists/*
COPY run-vm.sh /usr/local/bin/run-cube-vm
ENTRYPOINT ["bash", "/usr/local/bin/run-cube-vm"]
